# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/moansubs

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# GoReleaser output
dist/
# scripts/plugin-package.sh output
dist-plugin/

# Editor/IDE
.idea/
.vscode/
plugin/dist/

# mkdocs build output and the throwaway venv `make docs` falls back to
site/
.mkdocs-venv/

# Local config — holds API keys and site credentials, never commit
/config.yaml
/config.yml

# Operator-supplied TLS cert and key for the deploy kit (deploy/README.md).
# A private key must never enter this repository.
deploy/certs/

# The filled-in copies of the deploy kit's *.example files. Each one holds
# something private -- an analytics hostname, a certificate path, object
# storage credentials -- and each is created by renaming a tracked example,
# which is exactly the shape that gets committed by accident.
deploy/dynamic/analytics.yml
deploy/dynamic/tls.yml
deploy/backup/rclone.conf
deploy/.env
